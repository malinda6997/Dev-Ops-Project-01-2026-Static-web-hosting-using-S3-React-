{
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "responsive",
          "screen",
          "layer",
          "import"
        ]
      }
    ],
    "property-no-unknown": [
      true,
      {
        "ignoreProperties": ["composes"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.css"],
      "customSyntax": "postcss-syntax"
    }
  ]
}
